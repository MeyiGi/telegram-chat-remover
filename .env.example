API_ID=your_api_id
API_HASH=your_api_hash
GIRLFRIEND_USERNAME=@username_or_phone
MY_PHONE=your_telegram_phone
# DATA_DIR=data
# TELEGRAM_SESSION=karlis_listener
DELETE_DRY_RUN=1
DIARY_ENABLED=1
DIARY_TIMEZONE=Asia/Bishkek
DIARY_HOUR=5
# DIARY_MAX_MESSAGES=500
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
NOTION_TOKEN=your_notion_integration_token
NOTION_DIARY_PARENT_PAGE_ID=your_notion_parent_page_id
# Optional Google Drive backup for Telegram photos, videos, and other media.
# First configure an OAuth Desktop app in Google Cloud and save its JSON below.
# GOOGLE_DRIVE_ENABLED=1
# GOOGLE_DRIVE_CLIENT_SECRETS=credentials/google-drive-client.json
# GOOGLE_DRIVE_TOKEN_FILE=data/google-drive-token.json
# GOOGLE_DRIVE_FOLDER_NAME=CoupleBot Media
# Or use a Notion data source/database:
# NOTION_DIARY_DATA_SOURCE_ID=your_notion_data_source_id
# NOTION_DIARY_TITLE_PROPERTY=Name
